# Copy to .env and edit. Every setting here can also be changed at runtime from the
# Settings page in the web UI (UI values override these).

# ---------- General ----------
TA_DEBUG=false
TA_DATA_DIR=./data
TA_DATABASE_URL=sqlite+aiosqlite:///./data/teacher_assistant.db
TA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Language model ----------
# ollama | openai_compat | fake   ("fake" is a deterministic stub used by the test suite)
TA_LLM_PROVIDER=ollama
TA_LLM_BASE_URL=http://localhost:11434
TA_LLM_MODEL=qwen3:8b
TA_LLM_API_KEY=
TA_LLM_TEMPERATURE=0.4
TA_LLM_MAX_TOKENS=8192
TA_LLM_TIMEOUT=600

# Context window. This is a CEILING, not a fixed value: by default the app measures your
# GPU and reduces it to whatever keeps the whole model in VRAM. That matters more than it
# sounds — Ollama does not refuse a context that will not fit, it silently moves layers
# onto the CPU, and generation becomes several times slower with every core pinned.
# Measured on an 8 GB card with an 8B model: 8K fits entirely on the GPU, 12K does not.
TA_LLM_NUM_CTX=16384
# Set to false to use TA_LLM_NUM_CTX exactly as written — right for a 24 GB card.
TA_LLM_AUTO_CONTEXT=true

# Let a reasoning model (Qwen3, DeepSeek-R1) write its chain of thought before answering.
# Off by default: measured on an RTX 4060, the same question-generation call took 47.5s
# with thinking and 19.9s without, because 550 of its 666 output tokens were scratchpad
# that gets discarded before parsing. This app plans explicitly in its own passes instead.
# Turn it on to trade time for depth. Models without a thinking mode ignore this.
TA_LLM_THINKING=false

# Check generated answer keys with a DIFFERENT model. Blank reuses the generation model.
# Asking the same weights to re-answer their own question is a weaker check than it looks:
# a model that believes the light reactions happen in the stroma believes it twice. It costs
# a model swap in and out of VRAM on a card that cannot hold both, so roughly twenty extra
# seconds per paper. Blank by default - on the errors tested here both models caught exactly
# the same ones, so the benefit is reasoned rather than demonstrated.
TA_LLM_VERIFY_MODEL=
# How many times to feed schema-validation errors back to the model before giving up
TA_LLM_MAX_REPAIR_ATTEMPTS=3

# Example: any OpenAI-compatible server (llama.cpp, vLLM, LM Studio, OpenRouter, Groq...)
# TA_LLM_PROVIDER=openai_compat
# TA_LLM_BASE_URL=http://localhost:8080/v1
# TA_LLM_MODEL=qwen2.5-14b-instruct
# TA_LLM_API_KEY=sk-...

# ---------- Embeddings / retrieval ----------
TA_EMBED_MODEL=BAAI/bge-small-en-v1.5
# auto | cpu | cuda | mps. "auto" uses the GPU when PyTorch sees one with room to spare,
# which makes indexing about 6x faster (measured: 5.9 -> 39 passages/sec on an RTX 4060).
# It falls back to the CPU when the language model has already filled the card.
TA_EMBED_DEVICE=auto
TA_EMBED_BATCH_SIZE=32
TA_CHUNK_TOKENS=512
TA_CHUNK_OVERLAP=64
TA_RETRIEVE_TOP_K=12

# ---------- Ingestion ----------
# Run OCR on PDFs that have no extractable text layer
TA_OCR_ENABLED=true
TA_OCR_LANGUAGES=eng
TA_MAX_UPLOAD_MB=100

# ---------- Jobs ----------
TA_WORKER_CONCURRENCY=2
